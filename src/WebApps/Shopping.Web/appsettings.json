{
  "ElasticConfiguration": {
    "Uri": "http://localhost:9200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "GatewayAddress": "https://localhost:6064"
  },
  "Resilience": {
    "CatalogService": {
      "MaxRetryAttempts": 3,
      "TimeoutSeconds": 10,
      "CircuitBreakerSamplingSeconds": 30
    },
    "BasketService": {
      "MaxRetryAttempts": 3,
      "TimeoutSeconds": 10,
      "CircuitBreakerSamplingSeconds": 30
    },
    "OrderingService": {
      "MaxRetryAttempts": 1,
      "TimeoutSeconds": 15,
      "CircuitBreakerSamplingSeconds": 30
    }
  }
}
