{
  "ElasticConfiguration": {
    "Uri": "http://localhost:9200"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "HealthChecksUI": {
    "HealthChecks": [
      { "Name": "Catalog API", "Uri": "http://catalog.api:8080/health" },
      { "Name": "Basket API", "Uri": "http://basket.api:8080/health" },
      { "Name": "Ordering API", "Uri": "http://ordering.api:8080/health" },
      { "Name": "Discount gRPC", "Uri": "http://discount.grpc:8080/health" },
      { "Name": "API Gateway", "Uri": "http://apigateway:8080/health" },
      { "Name": "Shopping Web", "Uri": "http://shopping.web:8080/health" }
    ],
    "EvaluationTimeInSeconds": 30,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
